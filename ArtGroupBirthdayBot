.github/workflows/bot.yml
name: Telegram Bot

on:
  workflow_dispatch:
  push:
    branches:
      - основной

jobs:
  run-bot:
    runs-on: ubuntu-latest

    steps:
      - name: Скачать код
        uses: actions/checkout@v4

      - name: Установить Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Установить зависимости
        run: npm install

      - name: Запустить бота
        env:
          BOT_TOKEN: ${{ secrets.BOT_TOKEN }}
        run: node birthday_telegram_bot.js
